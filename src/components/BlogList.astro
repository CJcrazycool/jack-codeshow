---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const fmt = (d: Date) =>
  d.toLocaleDateString('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<section id="blog" class="mx-auto max-w-5xl px-6 py-28">
  <div class="mb-14">
    <p class="font-mono text-sm text-neon-cyan">// 03. 博客</p>
    <h2 class="mt-3 text-4xl font-bold text-white">写下来的思考</h2>
  </div>

  <div class="space-y-4">
    {posts.map((post) => (
      <a
        href={`/blog/${post.slug}/`}
        class="group flex flex-col gap-2 rounded-2xl border border-white/[0.06] bg-white/[0.02] p-6 transition-all hover:border-neon-cyan/40 hover:bg-white/[0.04] md:flex-row md:items-center md:justify-between"
      >
        <div>
          <h3 class="text-xl font-semibold text-zinc-100 transition-colors group-hover:text-white">
            {post.data.title}
          </h3>
          <p class="mt-1.5 text-sm text-zinc-500">{post.data.description}</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <span class="font-mono text-xs text-neon-purple/80">#{t}</span>
            ))}
          </div>
        </div>
        <div class="flex shrink-0 items-center gap-3 md:flex-col md:items-end">
          <time class="font-mono text-sm text-zinc-500">{fmt(post.data.pubDate)}</time>
          <span class="text-zinc-600 transition-transform group-hover:translate-x-1 group-hover:text-neon-cyan">→</span>
        </div>
      </a>
    ))}
  </div>
</section>
